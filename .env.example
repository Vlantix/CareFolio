# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> your project -> Connect
#
# The publishable key (sb_publishable_...) goes in
# NEXT_PUBLIC_SUPABASE_ANON_KEY (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also
# works). Older projects call it the anon key.
#
# Add these SAME two variables in Vercel:
#   Project -> Settings -> Environment Variables -> then redeploy.
#
# .env.local is gitignored. Never commit real values.
# Never add the service_role key or any sb_secret_ key to this project.
# Both bypass Row Level Security and would let anyone with them read all
# your data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret that signs the "passed the email code" cookie.
# NOT a Supabase key, and never NEXT_PUBLIC_. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Put the same value in .env.local and in Vercel.
VERIFY_COOKIE_SECRET=

# The partner hospital's name, shown on screens. Not a secret.
NEXT_PUBLIC_FACILITY_NAME=

# The live site address, used in share-link QR codes. Not a secret.
# e.g. https://hackathon-f1-forge.vercel.app
NEXT_PUBLIC_SITE_URL=

# Which email service sends codes: "gmail" or "resend". Leave empty to
# use Gmail when its two settings are set, otherwise Resend.
EMAIL_PROVIDER=

# Gmail — sends the login codes to ANY inbox, free (~500/day). Use a team
# Gmail with 2-Step Verification on; create an App Password at
# myaccount.google.com/apppasswords. When these two are set, Gmail is used.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# …or instead of the App Password, Google OAuth (Google Cloud → OAuth
# client, Gmail API on, scope https://mail.google.com/). The refresh token
# comes from signing in once as GMAIL_USER (see README). All secret.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Resend (used when the Gmail pair isn't set) — sends the login codes
# straight from our server. Server only, never
# NEXT_PUBLIC_. While the sender is …@resend.dev, Resend only delivers to
# the Resend account owner's address; verify a domain to email anyone.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: only if you route password-reset emails through the Supabase
# Send Email Hook (/api/auth/send-email). Shown when you create it (v1,whsec_…).
SEND_EMAIL_HOOK_SECRET=
